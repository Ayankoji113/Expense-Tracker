# Copy to .env and fill in before deploying. docker compose reads this file automatically.

# --- required in production ---------------------------------------------------
# 32+ bytes of randomness. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# --- database (docker compose sets these itself; needed for other hosts) -------
# DB_URL=jdbc:postgresql://host:5432/expenses
# DB_USER=expenses
# DB_PASSWORD=

# --- where the frontend is served from (comma separated) ----------------------
# CORS_ORIGINS=https://expenses.example.com

# --- optional: Google sign-in -------------------------------------------------
# OAuth client ID from Google Cloud Console; used by both the API and the build.
GOOGLE_CLIENT_ID=

# --- optional: email for password reset codes ---------------------------------
# Without these the code is written to the server log instead of being emailed.
# Gmail needs an App Password, not the account password.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@expense-tracker.local

# --- optional -----------------------------------------------------------------
# JWT_TTL_HOURS=24
# SERVER_PORT=8080
